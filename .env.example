# FASE 13 — Environment template. Copy to .env and fill in REAL values.
# SECRETS: FEB_SCORE_DATABASE_URL and FEB_SCORE_API_KEYS must come from your
# secret manager / deployment env, NEVER from a committed file.

# Deployment environment: development | test | production
FEB_SCORE_ENV=production

# PostgreSQL DSN. REQUIRED in production (SQLite is never a production backend).
FEB_SCORE_DATABASE_URL=postgresql://feb:CHANGE_ME@db:5432/feb_score

# PostgreSQL password for the compose `db` service (used by the DSN above).
# REQUIRED by docker-compose.yml (no default).
POSTGRES_PASSWORD=CHANGE_ME

# Log verbosity: debug | info | warning | error | critical
FEB_SCORE_LOG_LEVEL=info

# API keys: "key=principal_id:role;key2=id2:role2". REQUIRED in production.
# role is one of editor | admin | system. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FEB_SCORE_API_KEYS=CHANGE_ME=ingest:system

# Rate limiting (in-memory, per-principal/IP; fixed window).
FEB_SCORE_RATE_LIMIT=true
FEB_SCORE_RATE_LIMIT_PER_MINUTE=120

# PostgreSQL timeouts (ms).
FEB_SCORE_PG_CONNECT_TIMEOUT=5000
FEB_SCORE_PG_STATEMENT_TIMEOUT=30000

# Bind host/port.
FEB_SCORE_HOST=0.0.0.0
FEB_SCORE_PORT=8000
