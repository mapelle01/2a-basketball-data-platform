{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/events/match_validated.v1.json",
  "title":"MatchValidated Event v1",
  "description":"Emitted when validation completes successfully. Payload includes checks performed and results. Business rules referenced by id in applied_rules.",
  "type":"object",
  "required":["event_id","meta","source","payload"],
  "additionalProperties":false,
  "$defs":{"uuid":{"type":"string","format":"uuid"}},
  "properties":{
    "event_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","produced_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"produced_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "source":{"type":"object","required":["origin"],"properties":{"origin":{"type":"string","enum":["collector","admin","system"]},"actor":{"type":"object","properties":{"id":{"type":"string"}}}},"additionalProperties":false},
    "payload":{"type":"object","required":["external_id","match_uuid","validation_result"],"properties":{"external_id":{"type":"string"},"match_uuid":{"type":"string","format":"uuid"},"validation_result":{"type":"string","enum":["OK","WARN","FAIL"]},"checks":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"result":{"type":"string","enum":["PASS","FAIL","WARN"]},"details":{"type":"string"}},"additionalProperties":false}},"applied_rules":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}
  },
  "examples":[
    {"event_id":"dddddddd-eeee-ffff-0000-111111111111","meta":{"version":"1.0","produced_at":"2026-02-01T20:12:30Z"},"source":{"origin":"system","actor":{"id":"validator-1"}},"payload":{"external_id":"2513600","match_uuid":"11111111-2222-3333-4444-555555555555","validation_result":"OK","checks":[{"id":"sum_periods","result":"PASS"}],"applied_rules":["R2"]}}
  ]
}