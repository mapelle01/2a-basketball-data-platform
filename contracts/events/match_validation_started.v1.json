{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/events/match_validation_started.v1.json",
  "title":"MatchValidationStarted Event v1",
  "description":"Emitted when validation for a match starts. Consumers can use this to observe validation progress.",
  "type":"object",
  "required":["event_id","meta","source","payload"],
  "additionalProperties":false,
  "$defs":{"uuid":{"type":"string","format":"uuid"}},
  "properties":{
    "event_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","produced_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"produced_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "source":{"type":"object","required":["origin"],"properties":{"origin":{"type":"string","enum":["collector","admin","system"]},"actor":{"type":"object","properties":{"id":{"type":"string"}}}},"additionalProperties":false},
    "payload":{"type":"object","required":["external_id","match_uuid"],"properties":{"external_id":{"type":"string"},"match_uuid":{"type":"string","format":"uuid"},"initiator":{"type":"string"}},"additionalProperties":false}
  },
  "examples":[
    {"event_id":"cccccccc-dddd-eeee-ffff-000000000000","meta":{"version":"1.0","produced_at":"2026-02-01T20:12:00Z"},"source":{"origin":"system","actor":{"id":"validator-1"}},"payload":{"external_id":"2513600","match_uuid":"11111111-2222-3333-4444-555555555555","initiator":"validator-1"}}
  ]
}