{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/events/match_upserted.v1.json",
  "title":"MatchUpserted Event v1",
  "description":"Emitted when a Match is created or updated provisionally. Consumers may validate further. Contains reference to raw source.",
  "type":"object",
  "required":["event_id","meta","source","payload"],
  "additionalProperties":false,
  "$defs":{
    "uuid":{"type":"string","format":"uuid"},
    "source":{"type":"object","required":["origin"],"properties":{"origin":{"type":"string","enum":["collector","admin","system"]},"actor":{"type":"object","properties":{"id":{"type":"string"}}}},"additionalProperties":false}
  },
  "properties":{
    "event_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","produced_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"produced_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "source":{"$ref":"#/$defs/source"},
    "payload":{"type":"object","required":["external_id","match_uuid","competition_id","season_code","status","source"],"properties":{"external_id":{"type":"string"},"match_uuid":{"type":"string","format":"uuid"},"competition_id":{"type":"string"},"season_code":{"type":"string"},"status":{"type":"string","enum":["PROVISIONAL","SCHEDULED","IN_PLAY","FINALIZED","POSTPONED","CANCELLED"]},"source":{"type":"object"},"summary":{"type":"object"}},"additionalProperties":false}
  },
  "examples":[
    {
      "event_id":"bbbbbbbb-cccc-dddd-eeee-ffffffffffff",
      "meta":{"version":"1.0","produced_at":"2026-02-01T20:11:00Z"},
      "source":{"origin":"collector","actor":{"id":"ingestor-1"}},
      "payload":{"external_id":"2513600","match_uuid":"11111111-2222-3333-4444-555555555555","competition_id":"segundafeb","season_code":"2025-2026","status":"PROVISIONAL","source":{"id":"feb-api","s3_path":"s3://raw/2513600_boxscore.json"}}
    }
  ]
}