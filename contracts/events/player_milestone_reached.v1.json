{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/events/player_milestone_reached.v1.json",
  "title":"PlayerMilestoneReached Event v1",
  "description":"Emitted when a player reaches a defined milestone (career points, games, etc.).",
  "type":"object",
  "required":["event_id","meta","source","payload"],
  "additionalProperties":false,
  "$defs":{"uuid":{"type":"string","format":"uuid"}},
  "properties":{
    "event_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","produced_at"],"properties":{"version":{"type":"string"},"produced_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "source":{"type":"object","required":["origin"],"properties":{"origin":{"type":"string","enum":["analytics","system"]},"actor":{"type":"object","properties":{"id":{"type":"string"}}}},"additionalProperties":false},
    "payload":{"type":"object","required":["player_external_id","milestone_type","value","achieved_at"],"properties":{"player_external_id":{"type":"string"},"player_id":{"type":"string","format":"uuid"},"milestone_type":{"type":"string"},"value":{"type":"number"},"achieved_at":{"type":"string","format":"date-time"},"context":{"type":"object"}},"additionalProperties":false}
  },
  "examples":[
    {"event_id":"77777777-8888-9999-aaaa-bbbbbbbbbbbc","meta":{"version":"1.0","produced_at":"2026-02-02T02:11:00Z"},"source":{"origin":"analytics","actor":{"id":"analytics-1"}},"payload":{"player_external_id":"pl-987","milestone_type":"career_points","value":1000,"achieved_at":"2026-02-02T02:11:00Z","context":{"match_external_id":"2513600"}}}
  ]
}