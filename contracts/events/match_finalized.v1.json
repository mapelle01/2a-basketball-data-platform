{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/events/match_finalized.v1.json",
  "title":"MatchFinalized Event v1",
  "description":"Emitted when a match is finalized. Payload includes summary statistics and references to snapshots produced.",
  "type":"object",
  "required":["event_id","meta","source","payload"],
  "additionalProperties":false,
  "$defs":{"uuid":{"type":"string","format":"uuid"}},
  "properties":{
    "event_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","produced_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"produced_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "source":{"type":"object","required":["origin"],"properties":{"origin":{"type":"string","enum":["collector","admin","system"]},"actor":{"type":"object","properties":{"id":{"type":"string"}}}},"additionalProperties":false},
    "payload":{"type":"object","required":["external_id","match_uuid","finalized_at","score_summary"],"properties":{"external_id":{"type":"string"},"match_uuid":{"type":"string","format":"uuid"},"finalized_at":{"type":"string","format":"date-time"},"score_summary":{"type":"object","properties":{"home_score":{"type":"integer"},"away_score":{"type":"integer"},"periods":{"type":"array","items":{"type":"object"}}},"required":["home_score","away_score"]},"snapshots":{"type":"object","properties":{"standing_snapshot_id":{"type":"string"},"leaderboard_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}},"additionalProperties":false}
  },
  "examples":[
    {"event_id":"eeeeeeee-ffff-0000-1111-222222222222","meta":{"version":"1.0","produced_at":"2026-02-01T20:13:00Z"},"source":{"origin":"system","actor":{"id":"validator-1"}},"payload":{"external_id":"2513600","match_uuid":"11111111-2222-3333-4444-555555555555","finalized_at":"2026-02-01T20:13:00Z","score_summary":{"home_score":78,"away_score":75,"periods":[]},"snapshots":{"standing_snapshot_id":"snap-20260201","leaderboard_refs":["lb-points-2025"]}}}
  ]
}