{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/commands/register_player_to_squad.v1.json",
  "title":"RegisterPlayerToSquad Command v1",
  "description":"Command to register a player into a TeamRegistration (squad) for a season. Ensures player-team-season relation exists.",
  "type":"object",
  "required":["command_id","meta","actor","payload"],
  "additionalProperties":false,
  "$defs":{
    "uuid":{"type":"string","format":"uuid"},
    "actor":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"type":"string","enum":["admin","editor","system"]}},"additionalProperties":false}
  },
  "properties":{
    "command_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","issued_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"issued_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "actor":{"$ref":"#/$defs/actor"},
    "payload":{"type":"object","required":["player_external_id","team_external_id","season_code","registered_from"],"properties":{"player_external_id":{"type":"string"},"team_external_id":{"type":"string"},"season_code":{"type":"string"},"dorsal":{"type":"string"},"registered_from":{"type":"string","format":"date-time"},"registered_to":{"type":"string","format":"date-time"},"role":{"type":"string"}},"additionalProperties":false}
  },
  "examples":[
    {
      "command_id":"55555555-6666-7777-8888-999999999999",
      "meta":{"version":"1.0","issued_at":"2025-08-01T09:00:00Z"},
      "actor":{"id":"admin-1","role":"admin"},
      "payload":{"player_external_id":"pl-987","team_external_id":"team-123","season_code":"2025-2026","dorsal":"12","registered_from":"2025-08-01T00:00:00Z","registered_to":"2026-06-30T23:59:59Z","role":"player"}
    }
  ]
}