{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/commands/create_or_update_match.v1.json",
  "title": "CreateOrUpdateMatch Command v1",
  "description": "Command to create or update a provisional MatchAggregate with raw source references. Idempotent via command_id.",
  "type": "object",
  "required": ["command_id","meta","actor","payload"],
  "additionalProperties": false,
  "$defs": {
    "uuid": {"type":"string","format":"uuid"},
    "actor": {
      "type":"object",
      "required":["id","role"],
      "properties":{
        "id": {"type":"string","minLength":1},
        "role": {"type":"string","enum":["admin","editor","system"]}
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type":"object",
      "properties":{
        "id": {"type":"string"},
        "fetched_at": {"type":"string","format":"date-time"},
        "s3_path": {"type":"string","minLength":1}
      },
      "required":["id","fetched_at"],
      "additionalProperties": false
    },
    "teamRef":{
      "type":"object",
      "required":["external_id","name"],
      "properties":{
        "external_id":{"type":"string","minLength":1},
        "name":{"type":"string","minLength":1}
      },
      "additionalProperties": false
    }
  },
  "properties":{
    "command_id": {"$ref":"#/$defs/uuid"},
    "meta":{
      "type":"object",
      "required":["version","issued_at"],
      "properties":{
        "version":{"type":"string","pattern":"^\\d+\\.\\d+$","example":"1.0"},
        "issued_at":{"type":"string","format":"date-time"}
      },
      "additionalProperties": false
    },
    "actor": {"$ref":"#/$defs/actor"},
    "payload":{
      "type":"object",
      "required":["external_id","season_code","home_team","away_team","source","scheduled_at"],
      "properties":{
        "external_id":{"type":"string","minLength":1},
        "competition_id":{"type":"string","minLength":1},
        "season_code":{"type":"string","minLength":3},
        "round_number":{"type":"integer","minimum":1},
        "scheduled_at":{"type":"string","format":"date-time"},
        "home_team":{"$ref":"#/$defs/teamRef"},
        "away_team":{"$ref":"#/$defs/teamRef"},
        "venue":{"type":"object","properties":{"name":{"type":"string"},"city":{"type":"string"}},"additionalProperties": false},
        "source":{"$ref":"#/$defs/sourceRef"},
        "raw":{"type":"object","properties":{"boxscore_ref":{"type":"string"},"teamstats_ref":{"type":"string"}},"additionalProperties": false}
      },
      "additionalProperties": false
    }
  },
  "examples":[
    {
      "command_id":"3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "meta":{"version":"1.0","issued_at":"2026-02-01T20:10:00Z"},
      "actor":{"id":"ingestor-1","role":"system"},
      "payload":{
        "external_id":"2513600",
        "season_code":"2025-2026",
        "round_number":5,
        "scheduled_at":"2026-02-01T18:30:00+01:00",
        "home_team":{"external_id":"team-123","name":"CLASS BASQUET SANT ANTONI"},
        "away_team":{"external_id":"team-456","name":"INSOLAC CAJA 87"},
        "venue":{"name":"Pabellón X","city":"Ciudad"},
        "source":{"id":"feb-api","fetched_at":"2026-02-01T20:00:00Z","s3_path":"s3://raw/2513600_boxscore.json"},
        "raw":{"boxscore_ref":"s3://raw/2513600_boxscore.json"}
      }
    }
  ]
}