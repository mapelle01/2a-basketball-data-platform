{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.com/contracts/commands/approve_correction.v1.json",
  "title":"ApproveCorrection Command v1",
  "description":"Command for an admin-level principal (admin or system) to approve a proposed correction. Approval applies correction to MatchAggregate after domain validation.",
  "type":"object",
  "required":["command_id","meta","actor","payload"],
  "additionalProperties":false,
  "$defs":{
    "uuid":{"type":"string","format":"uuid"},
    "actor":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"type":"string","enum":["admin","editor","system"]}},"additionalProperties":false}
  },
  "properties":{
    "command_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","issued_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"issued_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "actor":{"$ref":"#/$defs/actor"},
    "payload":{"type":"object","required":["proposal_id","approved_by"],"properties":{"proposal_id":{"$ref":"#/$defs/uuid"},"approved_by":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"type":"string","enum":["admin","editor","system"]}},"additionalProperties":false},"approved_at":{"type":"string","format":"date-time"},"comment":{"type":"string"}},"additionalProperties":false}
  },
  "examples":[
    {
      "command_id":"33333333-4444-5555-6666-777777777777",
      "meta":{"version":"1.0","issued_at":"2026-02-02T12:00:00Z"},
      "actor":{"id":"admin-1","role":"admin"},
      "payload":{"proposal_id":"44444444-5555-6666-7777-888888888888","approved_by":{"id":"admin-1","role":"admin"},"approved_at":"2026-02-02T12:00:00Z","comment":"Verified with official act"}
    }
  ]
}