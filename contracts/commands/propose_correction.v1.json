{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/commands/propose_correction.v1.json",
  "title": "ProposeCorrection Command v1",
  "description": "Command to propose manual corrections to a match. The proposal is recorded and requires approval. The schema enforces traceability fields (proposed_by, reason, changes).",
  "type":"object",
  "required":["command_id","meta","actor","payload"],
  "additionalProperties":false,
  "$defs":{
    "uuid":{"type":"string","format":"uuid"},
    "actor":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"type":"string","enum":["admin","editor","system"]}},"additionalProperties":false},
    "changeOp":{"type":"object","required":["op"],"properties":{"op":{"type":"string","enum":["update_score","update_player_stat"]},"home_score":{"type":"integer"},"away_score":{"type":"integer"},"player_external_id":{"type":"string"},"values":{"type":"object"}},"additionalProperties":false},
    "changeArray":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/changeOp"}}
  },
  "properties":{
    "command_id":{"$ref":"#/$defs/uuid"},
    "meta":{"type":"object","required":["version","issued_at"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+$"},"issued_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "actor":{"$ref":"#/$defs/actor"},
    "payload":{"type":"object","required":["match_external_id","proposed_by","reason","changes"],"properties":{"match_external_id":{"type":"string"},"proposed_by":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"type":"string","enum":["admin","editor","system"]}},"additionalProperties":false},"reason":{"type":"string","minLength":5},"changes":{"$ref":"#/$defs/changeArray"}},"additionalProperties":false}
  },
  "examples":[
    {
      "command_id":"22222222-3333-4444-5555-666666666666",
      "meta":{"version":"1.0","issued_at":"2026-02-02T10:00:00Z"},
      "actor":{"id":"editor-12","role":"editor"},
      "payload":{"match_external_id":"2513600","proposed_by":{"id":"editor-12","role":"editor"},"reason":"Official act corrected score","changes":[{"op":"update_score","home_score":78,"away_score":75},{"op":"update_player_stat","player_external_id":"pl-987","values":{"points":24,"assists":6}}]}
    }
  ]
}